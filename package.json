{
  "name": "dsh-browser-cockpit",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "A live Chrome cockpit for DeepSeek Harness agents: browser tools, a side-by-side live view, and an activity log.",
  "license": "MIT",
  "author": "QinG1022",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QinG1022/dsh-browser-cockpit.git"
  },
  "homepage": "https://github.com/QinG1022/dsh-browser-cockpit#readme",
  "bugs": {
    "url": "https://github.com/QinG1022/dsh-browser-cockpit/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "browser",
    "chrome",
    "cdp",
    "automation",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
